{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "8080", "."],
      "port": 8080
    },
    {
      "name": "static-server-8090",
      "runtimeExecutable": "npx",
